meta {
  name: Pay - viewer
  type: http
  seq: 67
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/settlements/:batchId/pay
  body: none
  auth: bearer
}

params:path {
  batchId: {{$randomUUID}}
}

auth:bearer {
  token: {{viewerToken}}
}

vars:pre-request {
  as: viewer
}

tests {
  test('viewer lacks payment.process: 403 forbidden, before the scope', () => {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal('forbidden');
  });
}

meta {
  name: Unpay - blank reason
  type: http
  seq: 74
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/settlements/:batchId/unpay
  body: json
  auth: bearer
}

params:path {
  batchId: {{$randomUUID}}
}

body:json {
  {
    "reason": "   "
  }
}

auth:bearer {
  token: {{paymentsToken}}
}

vars:pre-request {
  as: payments
}

tests {
  test('a blank reason: 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}

meta {
  name: Undo - payments
  type: http
  seq: 77
  tags: [
    smoke
  ]
}

post {
  url: {{baseUrl}}/api/v1/settlements/:batchId/undo
  body: json
  auth: bearer
}

params:path {
  batchId: {{$randomUUID}}
}

body:json {
  {
    "reason": "Smoke test"
  }
}

auth:bearer {
  token: {{paymentsToken}}
}

vars:pre-request {
  as: payments
}

tests {
  test('payments lacks settlement.process: 403 forbidden, before the scope', () => {
    expect(res.status).to.equal(403);
    expect(res.body.code).to.equal('forbidden');
  });
}

meta {
  name: Login as payments
  type: http
  seq: 11
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "userName": "{{process.env.SEED_PAYMENTS_USER}}",
    "password": "{{process.env.SEED_PASSWORD}}"
  }
}

vars:pre-request {
  selfAuth: true
}

script:post-response {
  // Token of the payments user: pay and unpay, and the 403 of undo. Never replaces accessToken.
  if (res.status === 200) {
    bru.setVar('paymentsToken', res.body.accessToken);
  }
}

tests {
  test('responds 200 with a token pair', () => {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a('string').and.not.empty;
  });
}

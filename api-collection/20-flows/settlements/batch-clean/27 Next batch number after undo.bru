meta {
  name: 27 Next batch number after undo
  type: http
  seq: 28
  tags: [
    flow
  ]
}

get {
  url: {{baseUrl}}/api/v1/accounts/:accountId/batch-number/next?importId={{setImportId}}
  body: none
  auth: inherit
}

params:query {
  importId: {{setImportId}}
}

params:path {
  accountId: {{providerAUsdAccountId}}
}

tests {
  test('proposes the same number, with attempt 2', () => {
    expect(res.status).to.equal(200);
    expect(res.body.batchNo).to.equal(bru.getVar('setBatchNo'));
    expect(res.body.attemptNo).to.equal(2);
    expect(res.body.reason).to.equal('reprocess');
  });
}

meta {
  name: 21 Unpay without reason
  type: http
  seq: 23
  tags: [
    flow
  ]
}

post {
  url: {{baseUrl}}/api/v1/settlements/:batchId/unpay
  body: json
  auth: bearer
}

params:path {
  batchId: {{setBatchId}}
}

body:json {
  {}
}

auth:bearer {
  token: {{paymentsToken}}
}

vars:pre-request {
  as: payments
}

tests {
  test('without a reason: 400 validation_error', () => {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal('validation_error');
  });
}

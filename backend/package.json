{
  "name": "@recon/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --conditions=recon-dist dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit src/modules/validation --coverage --coverage.include=src/modules/validation/**",
    "test:watch": "vitest --project unit",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.4",
    "@fastify/multipart": "10.1.4",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@recon/shared": "workspace:*",
    "argon2": "^0.44.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.6.0",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "fflate": "0.8.3",
    "openapi-types": "^12.1.3",
    "saxes": "6.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}

# Recon Tool deployment settings. Copy to infra/.env.deploy (ignored by Git) and fill in the blanks.
# Empty secrets stop the deployment with an error naming the variable.
# Do not use $, quotes or spaces in the values: Compose and sqlcmd would interpret them.

# bundled = SQL Server in this compose - external = another SQL Server (see docs/deploy.md)
DEPLOY_DB=bundled

# -- Secrets --
# SQL Server rejects weak passwords: 8+ characters with upper case, lower case, digits and symbols.
# In external mode nothing reads MSSQL_SA_PASSWORD, but it cannot be empty: write any value.
MSSQL_SA_PASSWORD=
# Application user (no schema changes in this deployment).
RECON_APP_PASSWORD=
# Migration and seed user.
RECON_MIGRATOR_PASSWORD=
# Session signing secret, 32 characters or more.
JWT_SECRET=
# Common password of the synthetic users created by the seed. The URL is public: make it strong.
SEED_PASSWORD=
# Token of the Cloudflare tunnel. Only the debug mode runs without it.
TUNNEL_TOKEN=

# -- Database connection --
DB_HOST=mssql
DB_PORT=1433
DB_NAME=ReconTool

# -- Optional --
MSSQL_PID=Developer
LOG_LEVEL=info